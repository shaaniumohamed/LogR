# --- Database: Neon (free tier) -------------------------------------------
# https://neon.tech → new project → copy the POOLED connection string
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#                          https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: restrict sign-in to specific addresses (comma separated).
# Leave empty to allow anyone with a Google account.
ALLOWED_EMAILS=""

# --- Price history (optional) ---------------------------------------------
# Free key from https://twelvedata.com — 8 calls/minute, 800/day, which is far
# more than a daily journal needs (one call covers a whole trading day).
# Leave it empty and the app falls back to importing a price CSV by hand.
TWELVEDATA_API_KEY=""

# --- Object storage: Cloudflare R2 (optional) -------------------------------
# Trade screenshots and the backtester's price history. Free tier: 10 GB.
# Setup: R2 → create bucket → CORS policy allowing GET/PUT/HEAD from your app's
# address → Manage API tokens → Object Read & Write on that bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Development only: point at a local S3-compatible stand-in instead of R2.
# R2_ENDPOINT="http://127.0.0.1:9100"
