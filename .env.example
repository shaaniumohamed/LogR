# --- Database: Neon (free tier) -------------------------------------------
# https://neon.tech → new project → copy the POOLED connection string
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#                          https://<your-app>.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional: restrict sign-in to specific addresses (comma separated).
# Leave empty to allow anyone with a Google account.
ALLOWED_EMAILS=""

# --- Price history (optional) ---------------------------------------------
# Free key from https://twelvedata.com — 8 calls/minute, 800/day, which is far
# more than a daily journal needs (one call covers a whole trading day).
# Leave it empty and the app falls back to importing a price CSV by hand.
TWELVEDATA_API_KEY=""
